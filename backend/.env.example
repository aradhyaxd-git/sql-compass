# ==============================================================================
# SQL COMPASS BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=6000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Distributed Logging & Tracing
# Set to 'production' to output newline-delimited JSON with correlation context.
# In 'development', outputs colored human-readable logs with [req:...] and [user:...] tags.

# Database Connections
# MongoDB Persistence: Users, assignments, attempts, XP flight logs
MONGO_URI=mongodb://localhost:27017/sqlcompass

# PostgreSQL Sandbox: Read-only query execution sandbox (Neon or local PostgreSQL)
NEON_DATABASE_URL=postgres://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
SANDBOX_RO_URL=postgres://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require

# ==============================================================================
# LLM & INFERENCE CONFIGURATION (GROQ / OPEN SOURCE MODELS)
# ==============================================================================
# Active provider: 'groq' or 'gemini' (defaults to 'groq' when GROQ_API_KEY is present)
LLM_PROVIDER=groq

# Groq API Key (Obtain from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Free-Tier Active Models:
# - CLASSIFY_MODEL: 'openai/gpt-oss-20b' (Fast, low latency, structured JSON outputs)
# - GENERATE_MODEL: 'openai/gpt-oss-120b' (High reasoning accuracy, structured outputs)
# - JUDGE_MODEL: 'openai/gpt-oss-120b'
CLASSIFY_MODEL=openai/gpt-oss-20b
GENERATE_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-120b

# Fallback Google Gemini Configuration (Optional if Groq is active)
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_API_KEY=your_gemini_api_key_here

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret
ADMIN_EMAIL=admin@sqlcompass.com
ADMIN_PASSWORD=your_secure_admin_password